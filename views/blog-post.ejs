<%
  const title = post.metaTitle || (post.title + ' | RemoveWildlifeNow');
  const metaDesc = post.metaDescription || post.excerpt || '';
  const canonical = '/blog/' + post.slug + '/';
  const P = present;
  const schema = JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": post.title,
    "url": "https://www.removewildlifenow.com" + canonical,
    "description": metaDesc,
    "datePublished": post.datePublished,
    "dateModified": post.dateModified || post.datePublished,
    "author": { "@type": "Organization", "name": "RemoveWildlifeNow" }
  });
  const rel = ((typeof relatedPostsList !== 'undefined' && relatedPostsList) || []).map(p => `
    <div class="postcard"><a href="/blog/${p.slug}/">
      <h3>${P.esc(p.title)}</h3>
      <p>${P.esc(p.excerpt || '')}</p>
    </a></div>`).join('');
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label:'Field Notes', href:'/blog/'}, {label: post.title}])}
    <p class="kicker">${P.esc(post.category || 'Field notes')}</p>
    <h1>${P.esc(post.title)}</h1>
    <p class="lede">${P.esc(post.excerpt || '')}</p>
  </div>
</section>
<section class="section">
  <div class="container">
    <div class="article">
      ${P.scrubVoice(post.body)}
    </div>
    ${P.callCard(pro, { heading: 'Hearing it at your house?' })}
    ${rel ? `<h2>More field notes</h2><div class="postlist">${rel}</div>` : ''}
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, schema, body }) %>
