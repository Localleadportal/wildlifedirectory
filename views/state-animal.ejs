<%
  // State-level animal page — /georgia/raccoon-removal/. A hub page (no single
  // assigned contractor — a state spans many counties), so it follows the
  // layout-include pattern used by state.ejs and animal-national.ejs rather than
  // the standalone contractor-injected template used by county-animal.ejs.
  const slug = toSlug(stateName);
  const pageUrl = `https://www.removewildlifenow.com/${slug}/${animal.slug}/`;
  const canonical = `/${slug}/${animal.slug}/`;

  const c = stateAnimalContent || {};
  const title = c.metaTitle || `${stateName} ${animal.name} | Licensed Local Contractors`;
  const metaDesc = c.metaDescription
    || `${animal.name} in ${stateName} — find a licensed local trapper for humane ${animal.name.toLowerCase()}. Typical cost ${animal.costRange}. Browse counties to find help near you.`;
  const h1 = c.h1 || `${stateName} ${animal.name}`;
  const heroSub = c.heroSub || animal.shortDesc;

  // Per-animal hero image when one exists in /public/images, else none.
  const HERO_IMG = {
    'raccoon-removal':  { src: '/images/raccoon-hero1.webp',  w: 1600, h: 1066 },
    'squirrel-removal': { src: '/images/squirrel-hero1.webp', w: 1920, h: 1280 },
    'snake-removal':    { src: '/images/snake-hero1.webp',    w: 1600, h: 1066 },
    'bat-removal':      { src: '/images/bat-hero1.webp',      w: 1200, h: 1600 }
  };
  const hero = HERO_IMG[animal.slug] || null;

  // Social-share image: use the animal's own hero (a real, on-topic photo) when one
  // exists, falling back to the sitewide default only for animals without a hero.
  const ogImage = hero
    ? `https://www.removewildlifenow.com${hero.src}`
    : 'https://www.removewildlifenow.com/images/og-default.jpg';

  const faqs = (c.faqs && c.faqs.length) ? c.faqs : [];

  // ── Schema graph: BreadcrumbList + WebPage + Service + Organization + WebSite
  //    (+ FAQPage when state-specific FAQs exist). Mirrors the hub-page shape. ──
  const graph = [
    {
      "@type": "BreadcrumbList",
      "@id": pageUrl + "#breadcrumb",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.removewildlifenow.com/" },
        { "@type": "ListItem", "position": 2, "name": stateName, "item": `https://www.removewildlifenow.com/${slug}/` },
        { "@type": "ListItem", "position": 3, "name": animal.name }
      ]
    },
    {
      "@type": "WebPage",
      "@id": pageUrl + "#webpage",
      "url": pageUrl,
      "name": title,
      "description": metaDesc,
      "isPartOf": { "@id": "https://www.removewildlifenow.com/#website" },
      "breadcrumb": { "@id": pageUrl + "#breadcrumb" },
      "about": { "@id": pageUrl + "#service" },
      "inLanguage": "en-US",
      "primaryImageOfPage": ogImage
    },
    {
      "@type": "Service",
      "@id": pageUrl + "#service",
      "name": `${animal.name} in ${stateName}`,
      "serviceType": animal.name,
      "description": metaDesc,
      "provider": { "@id": "https://www.removewildlifenow.com/#organization" },
      "areaServed": { "@type": "State", "name": stateName, "containedInPlace": { "@type": "Country", "name": "United States" } },
      "hasOfferCatalog": {
        "@type": "OfferCatalog",
        "name": `${animal.name} Services in ${stateName}`,
        "itemListElement": animal.services.map(svc => ({ "@type": "Offer", "itemOffered": { "@type": "Service", "name": svc } }))
      }
    },
    {
      "@type": "Organization",
      "@id": "https://www.removewildlifenow.com/#organization",
      "name": "RemoveWildlifeNow.com",
      "url": "https://www.removewildlifenow.com/",
      "logo": "https://www.removewildlifenow.com/favicon.png"
    },
    {
      "@type": "WebSite",
      "@id": "https://www.removewildlifenow.com/#website",
      "url": "https://www.removewildlifenow.com/",
      "name": "RemoveWildlifeNow.com",
      "publisher": { "@id": "https://www.removewildlifenow.com/#organization" }
    }
  ];
  if (faqs.length) {
    graph.push({
      "@type": "FAQPage",
      "@id": pageUrl + "#faq",
      "mainEntity": faqs.map(f => ({ "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } }))
    });
  }
  const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": graph });

  const extraHead = `
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="RemoveWildlifeNow.com">
    <meta property="og:locale" content="en_US">
    <meta property="og:url" content="${pageUrl}">
    <meta property="og:title" content="${title}">
    <meta property="og:description" content="${metaDesc}">
    <meta property="og:image" content="${ogImage}">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="${title}">
    <meta name="twitter:description" content="${metaDesc}">
    <meta name="twitter:image" content="${ogImage}">
  `;

  // ── Body sections ──
  const heroImgHtml = hero
    ? `<div style="margin-top:24px;text-align:center;"><img src="${hero.src}" width="${hero.w}" height="${hero.h}" alt="${animal.name} in ${stateName} — find a licensed local ${animal.name.toLowerCase()} contractor near you" loading="lazy" style="max-width:100%;max-height:520px;width:auto;height:auto;border-radius:12px;display:inline-block;"></div>`
    : '';

  const leadHtml = c.leadParagraph
    ? `<section class="county-content"><div class="container"><h2>What Makes ${stateName} ${animal.plural} Different</h2><p>${c.leadParagraph}</p></div></section>`
    : '';

  // Signs + process cards (reused from the animal definition; localized headings).
  const cardsHtml = `
<section class="services-section">
  <div class="container">
    <h2>${animal.name} Services Across ${stateName}</h2>
    <p class="section-sub">${animal.urgency}</p>
    <div class="service-cards">
      <div class="service-card featured">
        <span class="card-badge">Signs You Have ${animal.plural}</span>
        <h3>Warning Signs</h3>
        <p>${animal.season}</p>
        <ul class="card-list">${animal.signs.map(s => `<li>${s}</li>`).join('')}</ul>
      </div>
      <div class="service-card">
        <h3>What ${stateName} Pros Do</h3>
        <p>Licensed ${stateName} contractors handle every step of ${animal.name.toLowerCase()} — capture, exclusion, sanitation, and repair.</p>
        <ul class="card-list">${animal.services.map(s => `<li>${s}</li>`).join('')}</ul>
      </div>
    </div>
    ${heroImgHtml}
  </div>
</section>`;

  const extendedHtml = c.extendedBody
    ? `<section class="county-content"><div class="container">${c.extendedBody}</div></section>`
    : (animalRegionNote
        ? `<section class="county-content"><div class="container"><h2>${animal.name} in ${stateName} — What You Should Know</h2><p>${animalRegionNote}</p>${stateInfo ? `<p>All wildlife removal in ${stateName} is regulated by the <strong>${stateInfo.agency}</strong>. Contractors in our directory hold the required state permits and use only legal, humane methods.</p>` : ''}</div></section>`
        : '');

  const costHtml = `
<section class="county-content" style="background:#f8fafc;">
  <div class="container">
    <h2>${animal.name} Cost in ${stateName}</h2>
    <p style="font-size:1.5rem;font-weight:700;color:var(--primary);margin:0 0 8px;">${animal.costRange}</p>
    <p style="color:#6b7280;margin:0;">${animal.costNote} Pricing varies by region, contractor, and severity. Each contractor in our directory provides free property-specific estimates.</p>
  </div>
</section>`;

  // DOWN-links to indexable city-animal pages, with localized anchors.
  const cityLinks = (typeof cityAnimalLinks !== 'undefined' && cityAnimalLinks) ? cityAnimalLinks : [];
  const countyHtml = cityLinks.length
    ? `
<section class="counties-section">
  <div class="container">
    <div class="section-header">
      <h2>${animal.name} by City in ${stateName}</h2>
      <p>Find a licensed local contractor in your city</p>
    </div>
    <ul class="counties-grid">
      ${cityLinks.map(cl => `<li><a href="/${slug}/${cl.slug}/${animal.slug}/">${cl.name} ${animal.name}</a></li>`).join('')}
    </ul>
  </div>
</section>`
    : '';

  // Sibling animals at the state level (links across the state×animal layer).
  const siblingHtml = `
<section class="counties-section" style="background:var(--green-light);border-top:1px solid var(--green-border);">
  <div class="container">
    <div class="section-header">
      <h2>More Wildlife Services in ${stateName}</h2>
      <p>We handle every kind of wildlife problem across ${stateName}</p>
    </div>
    <ul class="counties-grid">
      ${ANIMALS.filter(a => a.slug !== animal.slug).map(a => `<li><a href="/${slug}/${a.slug}/">${stateName} ${a.name}</a></li>`).join('')}
    </ul>
  </div>
</section>`;

  const faqHtml = faqs.length
    ? `
<section class="county-content">
  <div class="container">
    <h2>Frequently Asked Questions — ${animal.name} in ${stateName}</h2>
    <div style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
      ${faqs.map((f, i) => `<details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;"${i === 0 ? ' open' : ''}><summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">${f.q}<span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span></summary><div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;">${f.a}</div></details>`).join('')}
    </div>
  </div>
</section>`
    : '';

  const body = `
<nav class="breadcrumb">
  <div class="container">
    <a href="/">Home</a> &rsaquo; <a href="/${slug}/">${stateName}</a> &rsaquo; <span>${animal.name}</span>
  </div>
</nav>

<section class="page-hero">
  <div class="container">
    <div class="hero-badge">${stateName}</div>
    <h1>${h1}</h1>
    <p>${heroSub}</p>
  </div>
</section>

<section class="cta-section">
  <div class="container">
    <div class="cta-box">
      <h2>Get Matched with a Licensed ${stateName} ${animal.name.replace(' Removal', '')} Pro</h2>
      <p class="cta-sub">Local experts in your area. Same-day and emergency service available.</p>
      <div class="phone-wrap">
        <a class="llp-phone phone-cta" href="tel:+18445443498">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          (844) 544-3498
        </a>
      </div>
      <p class="cta-note">Or browse by city below to find a verified local contractor.</p>
      <div class="cta-badges">
        <span class="cta-badge">Licensed &amp; Insured</span>
        <span class="cta-badge">Same-Day Available</span>
        <span class="cta-badge">Humane Methods</span>
      </div>
    </div>
  </div>
</section>
${leadHtml}
${cardsHtml}
${extendedHtml}
${costHtml}
${countyHtml}
${siblingHtml}
${faqHtml}

<section class="county-content" style="background:#f8fafc;">
  <div class="container">
    <p style="margin:0;color:#6b7280;">Looking for nationwide info? See our <a href="/services/${animal.slug}/">${animal.name}</a> guide, or browse <a href="/${slug}/">all wildlife removal in ${stateName}</a>.</p>
  </div>
</section>`;
%>
<%- include('layout', { title, metaDesc, canonical, schema, extraHead, body, noindex: !indexable }) %>
