<%
  const P = present;
  const abbr = stateName === 'Georgia' ? 'GA' : stateName === 'Tennessee' ? 'TN' : '';
  const pageUrl = 'https://www.removewildlifenow.com/' + stateSlug + '/' + animal.slug + '/';
  const canonical = '/' + stateSlug + '/' + animal.slug + '/';
  const C = stateAnimalContent || {};
  const animalName = animal.name.replace(/ Removal$/, '');
  const title = P.scrubVoice(C.metaTitle || (animalName + ' Removal in ' + stateName + ' — Signs, Seasons & the Law | RemoveWildlifeNow'));
  const metaDesc = P.scrubVoice(C.metaDescription || (animalName + ' removal across ' + stateName + ': signs, seasons, what the law allows, and how the work runs. Call ' + pro.phoneDisplay + '.'));
  const faqs = (Array.isArray(C.faqs) ? C.faqs : []).map(f => ({ q: P.scrubVoice(f.q), a: P.scrubVoice(f.a) }));
  const schemaObj = { "@context": "https://schema.org", "@graph": [
    P.serviceSchema({ pro, pageUrl, serviceType: animal.name, areaName: stateName }),
    ...(P.faqSchema(faqs) ? [P.faqSchema(faqs)] : [])
  ]};
  const schema = JSON.stringify(schemaObj);
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label: stateName, href:'/' + stateSlug + '/'}, {label: animalName}])}
    <p class="kicker">${P.esc(animal.name)} · ${P.esc(stateName)}</p>
    <h1>${P.esc(P.scrubVoice(C.h1 || (animalName + ' removal in ' + stateName)))}</h1>
    <p class="lede">${P.esc(P.scrubVoice(C.heroSub || animal.shortDesc))}</p>
    <div class="btnrow">
      <a class="btn" href="tel:${pro.phoneE164}">Call ${pro.phoneDisplay}</a>
      <a class="btn alt" href="/services/${animal.slug}/">${P.esc(animalName)} removal, in depth</a>
    </div>
    <figure class="hero-photo"><img src="/images/animal-${animal.slug}.webp" alt="${P.esc(animalName)} in ${P.esc(stateName)}" loading="lazy" onerror="this.parentNode.style.display='none'"></figure>
  </div>
</section>

<section class="section">
  <div class="container">
    ${C.leadParagraph ? `<p style="max-width:48em;font-size:1.08rem">${P.esc(P.scrubVoice(C.leadParagraph))}</p>` : ''}
    ${C.extendedBody ? P.scrubVoice(C.extendedBody) : ''}

    <p class="kicker">Signs &amp; the work</p>
    <h2>${P.esc(animalName)} signs to watch for</h2>
    <ul class="signs">
      ${(animal.signs || []).map(s => `<li>${P.esc(s)}</li>`).join('')}
    </ul>
    <h2>How the ${P.esc(stateName)} job runs</h2>
    <p style="max-width:48em">${P.esc(animal.process)}</p>
    ${stateInfo && stateInfo.wildlifeNote ? `<div class="fieldnotes"><p class="kicker">Field notes — ${P.esc(stateName)}</p><p>${P.esc(P.scrubVoice(stateInfo.wildlifeNote))}</p>${stateInfo.seasonNote ? `<p>${P.esc(P.scrubVoice(stateInfo.seasonNote))}</p>` : ''}</div>` : ''}

    <p class="kicker">Local pages</p>
    <h2>${P.esc(animalName)} removal by town</h2>
    <div class="citylinks">
      ${(cityAnimalLinks || []).map(l => `<a href="/${stateSlug}/${l.slug}/${animal.slug}/">${P.esc(animalName)} removal in ${P.esc(l.name)}</a>`).join('')}
    </div>

    ${P.callCard(pro, { heading: animalName + ' trouble in ' + stateName + '?' })}
    ${P.faqSection(faqs, animalName + ' questions — ' + stateName)}
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, schema, body }) %>
