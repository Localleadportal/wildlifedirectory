<%
  const P = present;
  const pageUrl = 'https://www.removewildlifenow.com/services/' + animal.slug + '/';
  const canonical = '/services/' + animal.slug + '/';
  const C = content || {};
  const animalName = animal.name.replace(/ Removal$/, '');
  const title = animalName + ' Removal — Signs, Costs & How the Job Runs | RemoveWildlifeNow';
  const metaDesc = animal.shortDesc + ' Signs, typical costs, humane methods, and how a ' + animalName.toLowerCase() + ' job runs in Georgia and Tennessee. Call ' + pro.phoneDisplay + '.';
  const faqs = (Array.isArray(C.faqs) ? C.faqs : []).map(f => ({ q: P.scrubVoice(f.q), a: P.scrubVoice(f.a) }));
  const asHtml = (t) => !t ? '' : (String(t).includes('<') ? P.scrubVoice(String(t)) : String(t).split(/\n\s*\n/).map(p => `<p style="max-width:48em">${P.esc(P.scrubVoice(p))}</p>`).join(''));
  const covered = (states || []).filter(s => s.hasStateAnimalPage);
  const schemaObj = { "@context": "https://schema.org", "@graph": [
    P.serviceSchema({ pro, pageUrl, serviceType: animal.name, areaName: 'Georgia and Tennessee' }),
    ...(P.faqSchema(faqs) ? [P.faqSchema(faqs)] : [])
  ]};
  const schema = JSON.stringify(schemaObj);
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label:'Animals'}, {label: animalName}])}
    <p class="kicker">${P.esc(animal.name)} · Species: ${P.esc(animal.species)}</p>
    <h1>${P.esc(animalName)} removal, done properly</h1>
    <p class="lede">${P.esc(animal.shortDesc)}</p>
    <div class="btnrow">
      <a class="btn" href="tel:${pro.phoneE164}">Call ${pro.phoneDisplay}</a>
      <a class="btn alt" href="/problems/">Not sure it&rsquo;s ${P.esc(animal.plural.toLowerCase())}? Start with the problem</a>
    </div>
    <figure class="hero-photo"><img src="/images/animal-${animal.slug}.webp" alt="${P.esc(animalName)}" loading="lazy" onerror="this.parentNode.style.display='none'"></figure>
  </div>
</section>

<section class="section">
  <div class="container">
    ${asHtml(C.intro)}
    ${asHtml(C.extendedBody)}

    <p class="kicker">Signs</p>
    <h2>Signs ${P.esc(animal.plural.toLowerCase())} have moved in</h2>
    <ul class="signs">
      ${(animal.signs || []).map(s => `<li>${P.esc(s)}</li>`).join('')}
    </ul>

    <p class="kicker">The work</p>
    <h2>How a ${P.esc(animalName.toLowerCase())} job runs</h2>
    <p style="max-width:48em">${P.esc(animal.process)}</p>
    <ul class="signs">
      ${(animal.services || []).map(s => `<li>${P.esc(s)}</li>`).join('')}
    </ul>
    <p style="max-width:48em">${P.esc(animal.urgency)}</p>

    <table class="costtable">
      <tr><th>Job</th><th>Typical range</th></tr>
      <tr><td>${P.esc(animal.name)} — typical job</td><td class="price">${P.esc(animal.costRange)}</td></tr>
    </table>
    <p class="fineprint">General guidance from typical work — not a quote. Your price is set after inspection, before work starts.</p>

    ${covered.length ? `<p class="kicker">Where we do this work</p><h2>${P.esc(animalName)} removal near you</h2><div class="chips">${covered.map(s => `<a class="chip" href="/${s.stateSlug}/${animal.slug}/">${P.esc(animalName)} removal in ${P.esc(s.stateName)}</a>`).join('')}</div>` : ''}

    ${P.callCard(pro, { heading: animalName + ' problem? One call.' })}
    ${P.faqSection(faqs, animalName + ' questions')}

    <h2>Other animals we remove</h2>
    <div class="chips">
      ${ANIMALS.filter(a => a.slug !== animal.slug).map(a => `<a class="chip" href="/services/${a.slug}/">${P.esc(a.name)}</a>`).join('')}
    </div>
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, schema, body }) %>
