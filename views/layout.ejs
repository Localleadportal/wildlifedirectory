<%
  // Page identity: `pro` comes from the route (server-side portal lookup on
  // location pages). Everything else falls back to the brand identity.
  const _pro = (typeof pro !== 'undefined' && pro) ? pro : ((typeof brandPro !== 'undefined' && brandPro) ? brandPro : { assigned:false, name:'RemoveWildlifeNow', phoneE164:'+18445443498', phoneDisplay:'(844) 544-3498' });
%><!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_ga') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="google-site-verification" content="3JRLI8bkr8zA1AdcdyAXaUrgcvhW4v1QbRRVEIUw5Ew" />
  <title><%- title %></title>
  <meta name="description" content="<%- metaDesc %>">
  <link rel="canonical" href="https://www.removewildlifenow.com<%- canonical %>">
  <link rel="stylesheet" href="/css/style.css?v=<%= cssVersion %>">
  <% if (typeof noindex !== 'undefined' && noindex) { %>
  <meta name="robots" content="noindex, follow">
  <% } %>
  <% if (typeof schema !== 'undefined' && schema) { %>
  <script type="application/ld+json"><%- schema %></script>
  <% } %>
  <% if (typeof extraHead !== 'undefined' && extraHead) { %>
  <%- extraHead %>
  <% } %>
  <link rel="icon" href="https://www.removewildlifenow.com/favicon.png" sizes="180x180" type="image/png">
</head>
<body>
  <div class="utility">
    <div class="container">
      <span><%= coveragePhraseAmp.toUpperCase() %> &nbsp;·&nbsp; LICENSED &amp; INSURED &nbsp;·&nbsp; SAME-DAY SERVICE</span>
      <span>CALL <a href="tel:<%= _pro.phoneE164 %>"><%= _pro.phoneDisplay %></a></span>
    </div>
  </div>
  <header class="masthead">
    <div class="container">
      <a href="/" class="wordmark">Remove<em>Wildlife</em>Now<small>Out · Sealed · Cleaned Up</small></a>
      <nav class="mainnav">
        <a href="/problems/">Problems</a>
        <a href="/guides/">Guides</a>
        <% coverageStates.slice(0, 2).forEach(s => { %><a href="/<%= s.slug %>/"><%= s.name %></a><% }); %>
        <% if (coverageStates.length > 2) { %><a href="/#areas">All areas</a><% } %>
        <a href="/blog/">Field Notes</a>
        <a href="/contact/">Contact</a>
      </nav>
      <div class="headcall">
        <span class="hc-label"><% if (_pro.assigned) { %><%= _pro.name %><% } else { %>Call us — 24/7<% } %></span>
        <a class="hc-num" href="tel:<%= _pro.phoneE164 %>"><%= _pro.phoneDisplay %></a>
      </div>
    </div>
  </header>

  <%- body %>

  <footer>
    <div class="container">
      <div class="cols">
        <div>
          <p class="fbrand">Remove<em>Wildlife</em>Now</p>
          <p style="max-width:22em">Wildlife removal across <%= coveragePhrase %> — animals out, entry points sealed, attics cleaned up. One call and we handle the rest.</p>
          <% if (_pro.assigned) { %><p>Your local crew: <strong style="color:#fff"><%= _pro.name %></strong></p><% } %>
          <p><a class="fphone" href="tel:<%= _pro.phoneE164 %>"><%= _pro.phoneDisplay %></a></p>
          <p style="font-family:var(--mono);font-size:.72rem;letter-spacing:.12em">OPEN 24/7 · SAME-DAY SERVICE</p>
        </div>
        <div>
          <h4>What's in your house?</h4>
          <ul>
            <li><a href="/problems/scratching-noises-in-the-attic/">Scratching in the attic</a></li>
            <li><a href="/problems/animal-in-the-wall/">Animal in the wall</a></li>
            <li><a href="/problems/droppings-in-the-attic/">Droppings in the attic</a></li>
            <li><a href="/problems/dead-animal-smell/">Dead-animal smell</a></li>
            <li><a href="/problems/holes-and-tunnels-in-the-yard/">Holes in the yard</a></li>
            <li><a href="/problems/animal-under-the-deck/">Animal under the deck</a></li>
            <li><a href="/problems/noises-in-the-chimney/">Noises in the chimney</a></li>
            <li><a href="/problems/something-in-the-crawlspace/">Something in the crawlspace</a></li>
          </ul>
        </div>
        <div>
          <h4>Animals we remove</h4>
          <ul>
            <li><a href="/services/raccoon-removal/">Raccoons</a></li>
            <li><a href="/services/squirrel-removal/">Squirrels</a></li>
            <li><a href="/services/bat-removal/">Bats</a></li>
            <li><a href="/services/rat-removal/">Rats &amp; mice</a></li>
            <li><a href="/services/snake-removal/">Snakes</a></li>
            <li><a href="/services/armadillo-removal/">Armadillos</a></li>
            <li><a href="/services/skunk-removal/">Skunks</a></li>
            <li><a href="/services/dead-animal-removal/">Dead animals</a></li>
          </ul>
        </div>
        <div>
          <h4>Guides &amp; areas</h4>
          <ul>
            <li><a href="/guides/wildlife-removal-cost-in-georgia/">What removal costs in Georgia</a></li>
            <li><a href="/guides/georgia-wildlife-calendar/">Georgia wildlife calendar</a></li>
            <li><a href="/guides/keep-wildlife-out/">Keep wildlife out for good</a></li>
<% if (coverageStates.length <= 12) { %><% coverageStates.forEach(s => { %>
            <li><a href="/<%= s.slug %>/"><%= s.name %> service area</a></li><% }); %><% } else { %>
            <li><a href="/#areas">Service areas — all <%= coverageStates.length %> states</a></li><% } %>
            <li><a href="/blog/">Field notes (blog)</a></li>
            <li><a href="/contact/">Contact us</a></li>
            <li><a href="/list-your-business/">List your business</a></li>
          </ul>
        </div>
      </div>
      <div class="legal">
        <span>© <%= new Date().getFullYear() %> RemoveWildlifeNow.com — Wildlife removal in <%= coveragePhrase %>.</span>
        <span><a href="/privacy-policy/">Privacy Policy</a> &nbsp;·&nbsp; <a href="/terms-of-service/">Terms of Service</a></span>
      </div>
    </div>
  </footer>

  <div class="callstrip">
    <span class="cs-text"><strong>Animal in the house?</strong> We answer 24/7 — same-day service.</span>
    <a class="cs-btn" href="tel:<%= _pro.phoneE164 %>">Call <%= _pro.phoneDisplay %></a>
  </div>
</body>
</html>
