<%
  const title = 'Contact Us | RemoveWildlifeNow';
  const metaDesc = 'Animal in the attic, wall or yard? Call (844) 544-3498 or send us a message — tell us what you are hearing, seeing or smelling and we will take it from there.';
  const canonical = '/contact/';
  const P = present;
  const fd = (typeof formData !== 'undefined' && formData) || {};
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label:'Contact'}])}
    <p class="kicker">Contact</p>
    <h1>Tell us what&rsquo;s going on</h1>
    <p class="lede">Fastest is a call — <a href="tel:${pro.phoneE164}">${pro.phoneDisplay}</a>, answered 24/7. Prefer to write? Send the form and we&rsquo;ll get back to you shortly.</p>
  </div>
</section>
<section class="section">
  <div class="container" style="max-width:640px">
    ${(typeof sent !== 'undefined' && sent) ? `
      <div class="fieldnotes">
        <p class="kicker">Message sent</p>
        <h2 style="margin-top:0">Thanks — we got it.</h2>
        <p>We received your message and will be in touch shortly. If the animal is in your living space right now, call us at <a href="tel:${pro.phoneE164}">${pro.phoneDisplay}</a> instead of waiting on a reply.</p>
        <p><a href="/">Back to the homepage</a></p>
      </div>` : `
      ${(typeof error !== 'undefined' && error) ? `<p style="color:#a33;font-weight:600">${P.esc(error)}</p>` : ''}
      <form class="lead-form" method="POST" action="/contact/">
        <div class="lead-row">
          <label><span>Your name</span><input type="text" name="name" required autocomplete="name" value="${P.esc(fd.name || '')}"></label>
          <label><span>Email</span><input type="text" name="email" required autocomplete="email" value="${P.esc(fd.email || '')}"></label>
        </div>
        <label><span>Phone</span><input type="tel" name="phone" autocomplete="tel" value="${P.esc(fd.phone || '')}"></label>
        <div class="lead-row">
          <label><span>County</span><input type="text" name="county" placeholder="e.g. Cobb County" value="${P.esc(fd.county || (typeof county !== 'undefined' ? county : '') || '')}"></label>
          <label><span>State</span><input type="text" name="state" placeholder="e.g. Georgia" value="${P.esc(fd.state || (typeof state !== 'undefined' ? state : '') || '')}"></label>
        </div>
        <label><span>What animal do you have?</span>
          <select name="animal">
            <option value="">Not sure / select…</option>
            ${['Raccoon','Squirrel','Bat','Rat or Mouse','Snake','Armadillo','Groundhog / Mole','Bird','Skunk','Opossum','Dead animal','Other'].map(a => `<option ${fd.animal === a ? 'selected' : ''}>${a}</option>`).join('')}
          </select>
        </label>
        <label><span>Describe the issue</span><textarea name="message" rows="4" placeholder="Where is the animal? Attic, crawlspace, yard? Any damage?">${P.esc(fd.message || '')}</textarea></label>
        <button type="submit" class="lead-btn">Send my message</button>
        <p class="lead-fine">Your details come only to us — we do the work.</p>
      </form>`}
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, body }) %>
