<%
  const pageUrl = 'https://www.removewildlifenow.com/' + stateSlug + '/' + countySlug + '/' + citySlug + '/' + animal.slug + '/';
  const _authoredFaqs = (cityAnimalContent && cityAnimalContent.faqs) ? cityAnimalContent.faqs : [];
  const _skipGeneric = !!(cityAnimalContent && cityAnimalContent.skipGenericFaqs);
  const allFaqs = _skipGeneric ? _authoredFaqs : _authoredFaqs.concat(faqs || []);
  const pageTitle = (cityAnimalContent && cityAnimalContent.metaTitle)
    ? cityAnimalContent.metaTitle
    : (animal.name + ' in ' + cityName + ', ' + stateName + ' — Licensed Local Experts');
  const pageDesc = (cityAnimalContent && cityAnimalContent.metaDescription)
    ? cityAnimalContent.metaDescription
    : (cityAnimalContent && cityAnimalContent.intro
        ? cityAnimalContent.intro.slice(0, 155).replace(/\s+\S*$/, '') + '…'
        : (animal.name + ' in ' + cityName + ', ' + stateName + ' (' + countyName + '). ' + (animal.costRange ? 'Typical cost ' + animal.costRange + '. ' : '') + 'Licensed local contractor — humane methods, same-day service.'));
  const ogImage = (cityAnimalContent && cityAnimalContent.ogImage)
    || 'https://www.removewildlifenow.com/images/hero1.webp';
  // Optional per-page override for og:title / twitter:title (separate from
  // pageTitle which drives the <title> tag). Falls back to pageTitle when unset.
  const socialTitle = (cityAnimalContent && cityAnimalContent.ogTitle) || pageTitle;
  const seoEnhanced = !!(cityAnimalContent && cityAnimalContent.geo);
  const stateRegion = stateName === 'Georgia' ? 'GA'
    : stateName === 'Tennessee' ? 'TN'
    : stateName === 'Delaware' ? 'DE'
    : stateName === 'Connecticut' ? 'CT'
    : stateName === 'New Hampshire' ? 'NH'
    : stateName === 'Vermont' ? 'VT'
    : stateName === 'Rhode Island' ? 'RI' : '';

  // Contractor-aware phone + company name. Hoisted up here (rather than only in
  // the body) so the LocalBusiness JSON-LD below can pull the same dynamic phone
  // the on-page CTA uses — assigned contractor when LeadPortal returns one,
  // central dispatch otherwise. The body re-uses these same variables.
  const _phone = (countyContent && countyContent.contractor && countyContent.contractor.telephone)
    ? countyContent.contractor.telephone
    : '+18445443498';
  const _phoneDisplay = formatPhone(_phone);
  const _companyName = (countyContent && countyContent.contractor && countyContent.contractor.name)
    ? countyContent.contractor.name
    : null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_ga') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <%# description emitted unescaped so a literal ampersand renders as "&" rather
      than the "&amp;" produced by HTML-escaping. Mirrors og:title/twitter:title
      and county.ejs. Safe: city-animal metaDescriptions contain no double-quotes. %>
  <meta name="description" content="<%- pageDesc %>">
  <link rel="canonical" href="<%= pageUrl %>">
  <link rel="stylesheet" href="/css/style.css">
  <% if (!indexable) { %>
  <meta name="robots" content="noindex, follow">
  <% } else if (seoEnhanced) { %>
  <meta name="robots" content="index, follow">
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="RemoveWildlifeNow.com">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:title" content="<%- socialTitle %>">
  <meta property="og:description" content="<%- pageDesc %>">
  <meta property="og:image" content="<%= ogImage %>">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%- socialTitle %>">
  <meta name="twitter:description" content="<%- pageDesc %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <% if (seoEnhanced) { %>
  <!-- Geo -->
  <meta name="geo.region" content="US-<%= stateRegion %>">
  <meta name="geo.placename" content="<%= cityName %>, <%= stateName %>">
  <meta name="geo.position" content="<%= cityAnimalContent.geo.lat %>;<%= cityAnimalContent.geo.lon %>">
  <meta name="ICBM" content="<%= cityAnimalContent.geo.lat %>, <%= cityAnimalContent.geo.lon %>">

  <!-- BreadcrumbList -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": pageUrl + "#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.removewildlifenow.com/" },
      { "@type": "ListItem", "position": 2, "name": stateName, "item": "https://www.removewildlifenow.com/" + stateSlug + "/" },
      { "@type": "ListItem", "position": 3, "name": countyName, "item": "https://www.removewildlifenow.com/" + stateSlug + "/" + countySlug + "/" },
      { "@type": "ListItem", "position": 4, "name": cityName, "item": "https://www.removewildlifenow.com/" + stateSlug + "/" + countySlug + "/" + citySlug + "/" },
      { "@type": "ListItem", "position": 5, "name": animal.name }
    ]
  }) %>
  </script>

  <!-- WebPage -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": pageUrl + "#webpage",
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDesc,
    "isPartOf": { "@id": "https://www.removewildlifenow.com/#website" },
    "breadcrumb": { "@id": pageUrl + "#breadcrumb" },
    "inLanguage": "en-US",
    "about": { "@id": pageUrl + "#service" },
    "primaryImageOfPage": ogImage
  }) %>
  </script>
  <% } %>

  <!-- Service / LocalBusiness -->
  <%
    const _bizOverride = (cityAnimalContent && cityAnimalContent.businessOverride) || {};
    // Schema phone + name pull from the same dynamic contractor source as the
    // on-page CTA, so an assignment change in LeadPortal propagates to the
    // JSON-LD without per-page edits. Explicit businessOverride still wins.
    const _schemaName  = _bizOverride.name || _companyName || (animal.name + " in " + cityName);
    const _schemaPhone = _bizOverride.telephone || _phone;
    const _schemaGeo   = _bizOverride.geo || (cityAnimalContent && cityAnimalContent.geo) || null;
    // priceRange mirrors the visible cost section: per-page override first, then
    // the animal's default costRange. Data-driven so every page emits its own.
    const _priceRange  = _bizOverride.priceRange || (cityAnimalContent && cityAnimalContent.costRangeOverride) || animal.costRange || null;
  %>
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService"],
    ...(seoEnhanced ? { "@id": pageUrl + "#business" } : {}),
    "name": _schemaName,
    "description": animal.shortDesc + " Serving " + cityName + " and all of " + countyName + ", " + stateName + ".",
    "url": pageUrl,
    "telephone": _schemaPhone,
    ...(_schemaGeo ? { "geo": { "@type": "GeoCoordinates", "latitude": _schemaGeo.lat, "longitude": (_schemaGeo.lon !== undefined ? _schemaGeo.lon : _schemaGeo.lng) } } : {}),
    "areaServed": [
      { "@type": "City", "name": cityName + ", " + stateName },
      { "@type": "AdministrativeArea", "name": countyName + ", " + stateName }
    ],
    "serviceType": animal.name,
    ...(_priceRange ? { "priceRange": _priceRange } : {}),
    "openingHours": "Mo-Su 00:00-23:59",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": animal.name + " Services",
      "itemListElement": animal.services.map(function(svc) {
        return { "@type": "Offer", "itemOffered": { "@type": "Service", "name": svc } };
      })
    }
  }) %>
  </script>

  <% if (seoEnhanced) { %>
  <!-- Service (linked to LocalBusiness) -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "@id": pageUrl + "#service",
    "name": animal.name + " in " + cityName + ", " + stateName,
    "serviceType": animal.name,
    "provider": { "@id": pageUrl + "#business" },
    "areaServed": {
      "@type": "City",
      "name": cityName + ", " + stateName,
      ...(cityAnimalContent.sameAs && cityAnimalContent.sameAs.length ? { "sameAs": cityAnimalContent.sameAs } : {})
    },
    "description": pageDesc
  }) %>
  </script>
  <% } %>

  <% if (allFaqs && allFaqs.length) { %>
  <!-- FAQPage -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    ...(seoEnhanced ? { "@id": pageUrl + "#faq" } : {}),
    "mainEntity": allFaqs.map(function(f){
      return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
    })
  }) %>
  </script>
  <% } %>
  <link rel="icon" href="https://www.removewildlifenow.com/favicon.png" sizes="180x180" type="image/png">
</head>
<body>
  <%# _phone / _phoneDisplay / _companyName are declared in the head scriptlet
      above (so the LocalBusiness JSON-LD can pull the same dynamic contractor
      phone the on-page CTA uses). Body references those same variables. %>
  <header>
    <div class="container header-inner">
      <a href="/" class="logo">RemoveWildlife<span>Now</span></a>
      <nav class="header-nav">
        <a href="/<%= stateSlug %>/"><%= stateName %></a>
        <a href="/<%= stateSlug %>/<%= countySlug %>/"><%= countyName %></a>
        <a href="/<%= stateSlug %>/<%= countySlug %>/<%= citySlug %>/"><%= cityName %></a>
      </nav>
      <a class="llp-phone header-phone" href="tel:<%= _phone %>">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <%= _phoneDisplay %>
      </a>
    </div>
  </header>

  <div class="trust-bar">
    <div class="container trust-bar-inner">
      <div class="trust-item">24/7 Emergency Response</div>
      <div class="trust-item">Licensed &amp; Insured</div>
      <div class="trust-item">Humane Methods</div>
      <div class="trust-item">Local Experts</div>
    </div>
  </div>

  <main>
    <nav class="breadcrumb">
      <div class="container">
        <a href="/">Home</a> &rsaquo;
        <a href="/<%= stateSlug %>/<%= countySlug %>/"><%= countyName %></a> &rsaquo;
        <a href="/<%= stateSlug %>/<%= countySlug %>/<%= citySlug %>/"><%= cityName %></a> &rsaquo;
        <span><%= animal.name %></span>
      </div>
    </nav>

    <section class="page-hero">
      <div class="container">
        <div class="hero-badge"><%= cityName %>, <%= stateName %></div>
        <h1><% if (!(cityAnimalContent && cityAnimalContent.hideHeroEmoji)) { %><span aria-hidden="true"><%= animal.emoji %></span> <% } %><%= (cityAnimalContent && cityAnimalContent.h1Override) || (animal.name + ' in ' + cityName) %></h1>
        <p>Local licensed expert serving <%= cityName %> and all of <%= countyName %>. <%= animal.shortDesc %></p>
      </div>
    </section>

    <% if (cityAnimalContent && cityAnimalContent.intro) { %>
    <section class="county-content">
      <div class="container">
        <h2><%= animal.plural %> in <%= cityName %>, <%= stateName %></h2>
        <% if (cityAnimalContent.intro.trim().charAt(0) === '<') { %>
        <%- cityAnimalContent.intro %>
        <% } else { %>
        <p><%- cityAnimalContent.intro %></p>
        <% } %>
      </div>
    </section>
    <% } %>

    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <% if (!(cityAnimalContent && cityAnimalContent.hideCtaH2)) { %><h2><%= animal.name %> — <%= cityName %>, <%= stateName %></h2><% } %>
          <% if (_companyName) { %>
          <p class="llp-company-name company-name"><%= _companyName %></p>
          <% } else { %>
          <p class="llp-company-name company-name" style="display:none;"></p>
          <% } %>
          <p class="cta-sub">Licensed local expert. Same-day and emergency service in <%= cityName %>.</p>
          <div class="phone-wrap">
            <a class="llp-phone phone-cta" href="tel:<%= _phone %>">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <%= _phoneDisplay %>
            </a>
          </div>
          <p class="cta-note llp-available-only">Serving <%= cityName %> and all of <%= countyName %>, <%= stateName %></p>
          <% if (!indexable) { %>
          <div class="no-contractor-section" id="no-contractor">
            <h3><a href="tel:<%= _phone %>" style="color:inherit;text-decoration:none;"><%= _phoneDisplay %></a></h3>
            <p>We're expanding. Contact us and we'll find <%= animal.name.toLowerCase() %> help in <%= cityName %> fast.</p>
            <a href="/contact/?county=<%= encodeURIComponent(countyName) %>&state=<%= encodeURIComponent(stateName) %>" class="btn-contact">Contact Us for Help</a>
          </div>
          <% } %>
          <div class="cta-badges">
            <span class="cta-badge"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Licensed &amp; Insured</span>
            <span class="cta-badge"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Same-Day Available</span>
            <span class="cta-badge"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Humane Methods</span>
          </div>
        </div>
      </div>
    </section>

    <section class="services-section">
      <div class="container">
        <% if (animal.slug === 'opossum-removal') { %><div class="section-photo-banner"><img src="/images/hero11.webp" width="1440" height="1920" alt="Wild opossum spotted in <%= cityName %> yard — humane possum removal and prevention experts" loading="lazy" class="banner-img"><% } %>
        <h2><%= animal.name %> in <%= cityName %> — What to Expect</h2>
        <p class="section-sub"><%= animal.urgency %></p>
        <% if (animal.slug === 'opossum-removal') { %></div><% } %>
        <div class="service-cards">
          <div class="service-card featured">
            <span class="card-badge">Signs in <%= cityName %></span>
            <span class="card-icon"><%= animal.emoji %></span>
            <h3>Signs You Have <%= animal.plural %></h3>
            <p><%= (cityAnimalContent && cityAnimalContent.seasonOverride) || animal.season %></p>
            <ul class="card-list">
              <% animal.signs.forEach(sign => { %>
              <li><%= sign %></li>
              <% }); %>
            </ul>
            <a class="llp-phone card-phone" href="tel:<%= _phone %>">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <%= _phoneDisplay %>
            </a>
          </div>
          <div class="service-card">
            <span class="card-icon">🛠️</span>
            <h3>Our Process in <%= cityName %></h3>
            <p>Our local <%= countyName %> contractor serves all of <%= cityName %> using the same proven, humane process for every job.</p>
            <ul class="card-list">
              <% animal.services.forEach(svc => { %>
              <li><%= svc %></li>
              <% }); %>
            </ul>
            <a class="llp-phone card-phone" href="tel:<%= _phone %>">
              <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <%= _phoneDisplay %>
            </a>
          </div>
        </div>
        <% if (animal.slug === 'raccoon-removal') { %>
        <div style="margin-top:32px;text-align:center;">
          <img src="/images/raccoon-hero1.webp" width="1600" height="1066" alt="Adult raccoon (Procyon lotor) on a residential property in <%= cityName %>, <%= countyName %>, <%= stateName %> — licensed local raccoon removal contractor for attic exclusion, humane trapping, sanitation, and entry-point repair in <%= cityName %>" title="<%= cityName %> raccoon removal near me — licensed local raccoon trapper and exclusion contractor in <%= cityName %>, <%= stateName %>" loading="lazy" style="max-width:100%;max-height:640px;width:auto;height:auto;border-radius:12px;display:inline-block;">
        </div>
        <% } %>
        <% if (animal.slug === 'squirrel-removal') { %>
        <div style="margin-top:32px;text-align:center;">
          <img src="/images/squirrel-hero1.webp" width="1920" height="1280" alt="Eastern gray squirrel (Sciurus carolinensis) on a residential roof gutter in <%= cityName %>, <%= countyName %>, <%= stateName %> — licensed local squirrel removal contractor for attic exclusion, humane trapping, chewed-wire repair, and entry-point sealing in <%= cityName %>" title="<%= cityName %> squirrel removal near me — licensed local squirrel trapper and attic exclusion contractor in <%= cityName %>, <%= stateName %>" loading="lazy" style="max-width:100%;max-height:640px;width:auto;height:auto;border-radius:12px;display:inline-block;">
        </div>
        <% } %>
        <% if (animal.slug === 'snake-removal') { %>
        <div style="margin-top:32px;text-align:center;">
          <img src="/images/snake-hero1.webp" width="1600" height="1066" alt="<%= (cityAnimalContent && cityAnimalContent.heroImageAlt) || ('Eastern rat snake (Pantherophis alleghaniensis) in a residential yard in ' + cityName + ', ' + countyName + ', ' + stateName + ' — licensed local snake removal contractor for venomous and non-venomous snake identification, humane relocation, copperhead removal, and yard exclusion in ' + cityName) %>" title="<%= cityName %> snake removal near me — licensed local snake identification and removal contractor in <%= cityName %>, <%= stateName %>" loading="lazy" style="max-width:100%;max-height:640px;width:auto;height:auto;border-radius:12px;display:inline-block;">
        </div>
        <% } %>
        <% if (animal.slug === 'bat-removal') { %>
        <div style="margin-top:32px;text-align:center;">
          <img src="/images/bat-hero1.webp" width="1200" height="1600" alt="Big brown bat (Eptesicus fuscus) safely handled during a residential bat exclusion job in <%= cityName %>, <%= countyName %>, <%= stateName %> — licensed local bat removal contractor for chimney and attic bat colony exclusion, maternity-season-aware timing, guano remediation, and Georgia DNR-compliant work in <%= cityName %>" title="<%= cityName %> bat removal near me — licensed local bat exclusion and chimney/attic colony contractor in <%= cityName %>, <%= stateName %>" loading="lazy" style="max-width:100%;max-height:640px;width:auto;height:auto;border-radius:12px;display:inline-block;">
        </div>
        <% } %>
      </div>
    </section>

    <% if (cityAnimalContent && cityAnimalContent.extendedBody) { %>
    <section class="county-content">
      <div class="container">
        <%- cityAnimalContent.extendedBody %>
      </div>
    </section>
    <% } %>

    <% if (seasonal) { %>
    <section class="county-content" style="background:<%= seasonal.level === 'high' ? '#fff7ed' : seasonal.level === 'moderate' ? '#f0fdf4' : '#f8fafc' %>;border-top:3px solid <%= seasonal.level === 'high' ? '#f97316' : seasonal.level === 'moderate' ? '#22c55e' : '#94a3b8' %>;">
      <div class="container">
        <h2 style="color:<%= seasonal.level === 'high' ? '#c2410c' : seasonal.level === 'moderate' ? '#15803d' : '#475569' %>;margin-bottom:8px;">
          <%= seasonal.level === 'high' ? '⚠️' : seasonal.level === 'moderate' ? '📅' : '📋' %> <%= seasonal.title %>
        </h2>
        <p><%= seasonal.msg %></p>
      </div>
    </section>
    <% } %>

    <% if ((animalRegionNote || stateInfo) && !(cityAnimalContent && cityAnimalContent.extendedBody)) { %>
    <section class="county-content">
      <div class="container">
        <h2><%= animal.name %> in <%= cityName %>, <%= stateName %> — Local Context</h2>
        <% if (animalRegionNote) { %>
        <p><%= animalRegionNote %></p>
        <% } %>
        <% if (stateInfo) { %>
        <p>All wildlife removal in <%= stateName %> is regulated by the <strong><%= stateInfo.agency %></strong>. Our <%= cityName %> contractor is fully licensed under the <%= stateInfo.agency %> and uses only permitted, humane removal methods.</p>
        <% } %>
      </div>
    </section>
    <% } %>

    <% if (animal.costRange) { %>
    <section class="county-content" style="background:#f8fafc;">
      <div class="container">
        <h2><%= animal.name %> Cost in <%= cityName %></h2>
        <p style="font-size:1.5rem;font-weight:700;color:var(--primary);margin:0 0 8px;"><%= (cityAnimalContent && cityAnimalContent.costRangeOverride) || animal.costRange %></p>
        <p style="color:#6b7280;margin:0;"><%= (cityAnimalContent && cityAnimalContent.costNoteOverride) || animal.costNote %> Call for an estimate — pricing varies by contractor and job complexity.</p>
      </div>
    </section>
    <% } %>

    <% if (allFaqs && allFaqs.length) { %>
    <section class="county-content">
      <div class="container">
        <h2>Frequently Asked Questions — <%= animal.name %> in <%= cityName %></h2>
        <div style="display:flex;flex-direction:column;gap:16px;margin-top:16px;">
          <% allFaqs.forEach(function(faq) { %>
          <details style="border:1px solid #e5e7eb;border-radius:10px;overflow:hidden;">
            <summary style="padding:16px 20px;font-weight:600;cursor:pointer;font-size:0.97rem;list-style:none;display:flex;justify-content:space-between;align-items:center;">
              <%= faq.q %>
              <span style="font-size:1.2rem;flex-shrink:0;margin-left:12px;">+</span>
            </summary>
            <div style="padding:0 20px 16px;color:#374151;line-height:1.7;font-size:0.93rem;border-top:1px solid #f3f4f6;"><%- faq.a %></div>
          </details>
          <% }); %>
        </div>
      </div>
    </section>
    <% } %>

    <% if (cityAnimalContent && cityAnimalContent.relatedLinks && cityAnimalContent.relatedLinks.length) { %>
    <section class="counties-section" style="background:var(--green-light);border-top:1px solid var(--green-border);">
      <div class="container">
        <div class="section-header">
          <h2><%= animal.name %> &amp; Other Wildlife — Across <%= countyName %></h2>
          <p>Same licensed contractor, broader coverage.</p>
        </div>
        <ul class="neighbor-list">
          <% cityAnimalContent.relatedLinks.forEach(l => { %>
          <li><a href="<%= l.href %>"><%= l.anchor %></a></li>
          <% }); %>
        </ul>
      </div>
    </section>
    <% } %>

    <section class="counties-section">
      <div class="container">
        <div class="section-header">
          <h2>More Wildlife Services in <%= cityName %></h2>
          <p>Your local contractor handles all wildlife removal needs</p>
        </div>
        <ul class="counties-grid">
          <% ANIMALS.filter(a => a.slug !== animal.slug).forEach(a => { %>
          <li><a href="/<%= stateSlug %>/<%= countySlug %>/<%= citySlug %>/<%= a.slug %>/"><%= a.emoji %> <%= a.name %></a></li>
          <% }); %>
        </ul>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p style="margin:0 0 6px;">Wildlife removal company? <a href="/list-your-business/" style="color:inherit;text-decoration:underline;">List your business</a> for exclusive county leads.</p>
      <p>&copy; <%= new Date().getFullYear() %> RemoveWildlifeNow.com &mdash; Connecting homeowners with licensed wildlife removal professionals nationwide.</p>
    </div>
  </footer>

  <script src="<%- embedScript %>"></script>

  <%# Sticky mobile call CTA — reuses the top-of-body _phone / _phoneDisplay
      that already gate every in-page anchor on the same contractor. %>
  <%- include('_mobile-call', { phone: _phone, phoneDisplay: _phoneDisplay }) %>
</body>
</html>
