<%
  const P = present;
  const abbr = stateName === 'Georgia' ? 'GA' : stateName === 'Tennessee' ? 'TN' : '';
  const pageUrl = 'https://www.removewildlifenow.com/' + stateSlug + '/' + citySlug + '/' + animal.slug + '/';
  const canonical = (typeof canonicalUrl !== 'undefined' && canonicalUrl)
    ? canonicalUrl.replace('https://www.removewildlifenow.com', '') : '/' + stateSlug + '/' + citySlug + '/' + animal.slug + '/';
  const fillTokens = (s) => {
    if (!s) return s;
    let out = P.scrubVoice(String(s)
      .replace(/\{\{\s*company\s*\}\}/g, pro.assigned ? pro.name : 'RemoveWildlifeNow')
      .replace(/\{\{\s*phone\s*\}\}/g, pro.phoneDisplay));
    if (pro.assigned) {
      const dashed = pro.phoneE164.replace('+1', '').replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3');
      out = out.split('(844) 544-3498').join(pro.phoneDisplay)
               .split('+18445443498').join(pro.phoneE164)
               .split('844-544-3498').join(dashed);
    }
    return out;
  };
  const C = composed || {};
  const animalName = animal.name.replace(/ Removal$/, '');
  const title = C.authoredMetaTitle ? fillTokens(C.authoredMetaTitle)
    : animalName + ' in ' + cityName + ', ' + abbr + ' — Removal, Exclusion & Cleanup | RemoveWildlifeNow';
  const metaDesc = C.authoredMetaDescription ? fillTokens(C.authoredMetaDescription)
    : animalName + ' trouble in ' + cityName + '? Humane removal, entry points sealed, attic cleaned up. Same-day service — call ' + pro.phoneDisplay + '.';
  const lede = C.authoredIntro || C.introFrame || (animal.shortDesc + ' In ' + cityName + ', we get them out, seal the way in, and clean up what they leave behind.');
  const faqs = C.faqs || [];
  const texture = C.texture;
  const monthNow = new Date().getMonth() + 1;
  const seasonNote = (seasonal && Array.isArray(seasonal.months) && seasonal.months.includes(monthNow)) ? seasonal : null;
  const regionNote = (typeof animalRegionNote === 'string' && animalRegionNote) ? animalRegionNote : '';
  const leadForm = include('_lead-form', { animalSlug: animal.slug });
  const schemaObj = { "@context": "https://schema.org", "@graph": [
    P.serviceSchema({ pro, pageUrl, serviceType: animal.name, areaName: cityName + ', ' + stateName }),
    ...(P.faqSchema(faqs) ? [P.faqSchema(faqs)] : [])
  ]};
  const schema = JSON.stringify(schemaObj);
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label: stateName, href:'/' + stateSlug + '/'}, {label: cityName, href:'/' + stateSlug + '/' + citySlug + '/'}, {label: animalName}])}
    <p class="kicker">${P.esc(animal.name)} · ${P.esc(cityName)}, ${abbr}</p>
    <h1>${P.esc(animalName)} trouble in ${P.esc(cityName)}?</h1>
    <p class="lede">${fillTokens(lede)}</p>
    <div class="btnrow">
      <a class="btn" href="tel:${pro.phoneE164}">Call ${pro.phoneDisplay}</a>
      <a class="btn alt" href="/${stateSlug}/${citySlug}/">All ${P.esc(cityName)} wildlife</a>
    </div>
    <figure class="hero-photo"><img src="/images/animal-${animal.slug}.webp" alt="${P.esc(animalName)} — wildlife removal in ${P.esc(cityName)}" loading="lazy" onerror="this.parentNode.style.display='none'"></figure>
  </div>
</section>

<section class="section">
  <div class="container">
    ${seasonNote ? `<div class="fieldnotes"><p class="kicker">Right now in ${P.esc(cityName)}</p><p><strong>${P.esc(P.scrubVoice(seasonNote.title))}.</strong> ${P.esc(P.scrubVoice(seasonNote.msg))}</p></div>` : ''}

    ${C.countyAnimalLead ? `<p style="max-width:48em">${fillTokens(C.countyAnimalLead)}</p>` : ''}
    <p class="kicker">Signs</p>
    <h2>How you know it&rsquo;s ${P.esc(animal.plural.toLowerCase())}</h2>
    ${C.signsIntro ? `<p style="max-width:48em">${P.esc(C.signsIntro)}</p>` : ''}
    <ul class="signs">
      ${(C.signs || animal.signs || []).map(s => `<li>${P.esc(s)}</li>`).join('')}
    </ul>
    ${C.signsFrame ? `<p style="max-width:48em">${P.esc(C.signsFrame)}</p>` : ''}

    ${C.authoredBody ? fillTokens(C.authoredBody) : ''}
    ${C.countyAnimalBody ? fillTokens(C.countyAnimalBody) : ''}
    ${regionNote ? `<p style="max-width:48em">${fillTokens(regionNote)}</p>` : ''}
    ${texture ? `<div class="fieldnotes"><p class="kicker">Field notes — ${P.esc(countyName)}</p><p>${P.esc(texture.terrain)}</p><p>${P.esc(texture.housing)}</p><p>${P.esc(texture.pressure)}</p></div>` : ''}
    ${(C.cityNotes && (C.cityNotes.neighborhoods.length || C.cityNotes.housing || C.cityNotes.geo)) ? `<div class="fieldnotes"><p class="kicker">Around ${P.esc(cityName)}</p>${C.cityNotes.neighborhoods.length ? `<p><strong>Neighbourhoods we work:</strong> ${C.cityNotes.neighborhoods.map(n => P.esc(n)).join(' · ')}</p>` : ''}${C.cityNotes.housing ? `<p>${P.esc(fillTokens(C.cityNotes.housing))}</p>` : ''}${C.cityNotes.geo ? `<p>${P.esc(fillTokens(C.cityNotes.geo))}</p>` : ''}</div>` : ''}
    ${(C.cityIntroParas || []).map(p => `<p style="max-width:48em">${fillTokens(p)}</p>`).join('')}
    ${C.geoNote ? `<p style="max-width:48em">${P.esc(C.geoNote)}</p>` : ''}

    <p class="kicker">The work</p>
    <h2>How we get ${P.esc(animal.plural.toLowerCase())} out of a ${P.esc(cityName)} home</h2>
    <p style="max-width:48em">${P.esc(C.processText || animal.process)}</p>
    ${C.processFrame ? `<p style="max-width:48em">${P.esc(C.processFrame)}</p>` : ''}
    <ul class="signs">
      ${(C.services || animal.services || []).map(s => `<li>${P.esc(s)}</li>`).join('')}
    </ul>
    ${C.localBridge ? `<p style="max-width:48em">${P.esc(C.localBridge)}</p>` : ''}
    ${C.processCloser ? `<p style="max-width:48em">${P.esc(C.processCloser)}</p>` : ''}

    <p class="kicker">Don&rsquo;t wait on it</p>
    <h2>Why ${P.esc(animal.plural.toLowerCase())} get more expensive</h2>
    <p style="max-width:48em">${P.esc(C.urgencyText || animal.urgency)}</p>
    ${C.urgencyFrame ? `<p style="max-width:48em">${P.esc(C.urgencyFrame)}</p>` : ''}
    ${C.waitRisk ? `<p style="max-width:48em">${P.esc(C.waitRisk)}</p>` : ''}

    <p class="kicker">Cost</p>
    <h2>What ${P.esc(animalName.toLowerCase())} removal runs in ${P.esc(cityName)}</h2>
    ${C.costIntro ? `<p style="max-width:48em">${P.esc(C.costIntro)}</p>` : ''}
    <table class="costtable">
      <tr><th>Job</th><th>Typical range</th></tr>
      <tr><td>${P.esc(animal.name)} — typical ${P.esc(cityName)} job</td><td class="price">${P.esc(animal.costRange)}</td></tr>
    </table>
    <p class="fineprint">General guidance from typical ${P.esc(stateName)} work — not a quote. Your price is set after we inspect your home, before work starts. ${stateName === 'Georgia' ? 'Full breakdown: <a href="/guides/wildlife-removal-cost-in-georgia/">what wildlife removal costs in Georgia</a>.' : 'See <a href="/guides/">our guides</a> for how pricing breaks down.'}</p>

    ${leadForm}
    ${P.callCard(pro, { heading: animalName + ' in ' + cityName + ' — handled today' })}
    ${P.faqSection(faqs, animalName + ' questions from ' + cityName + ' homeowners')}

    ${moreAnimals && moreAnimals.length ? `<h2>Other animals in ${P.esc(cityName)}</h2><div class="chips">${moreAnimals.map(a => `<a class="chip" href="/${stateSlug}/${citySlug}/${a.slug}/">${P.esc(a.name)}</a>`).join('')}</div>` : ''}
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, schema, body }) %>
