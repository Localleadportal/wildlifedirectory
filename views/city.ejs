<%
  const pageUrl = 'https://www.removewildlifenow.com/' + stateSlug + '/' + countySlug + '/' + citySlug + '/';
  // Title pattern: leads with city + service keyword, then the two highest-
  // converting phrases ("same-day", "24/7"). If the full title would exceed
  // ~60 chars, fall back to a shorter variant.
  const _primaryTitle = cityName + ' Wildlife Removal — Same-Day & 24/7 Emergency';
  const _defaultTitle = _primaryTitle.length <= 60 ? _primaryTitle : (cityName + ' Wildlife Removal — Same-Day Service');
  const pageTitle = (cityContent && cityContent.metaTitle) ? cityContent.metaTitle : _defaultTitle;

  // Description pattern: mirrors searcher situation ("Got wildlife in your
  // home?"), urgency, then either the per-county metaHook (a real local
  // differentiator like "historic-home & chimney bat specialists.") or the
  // generic species list. Set metaHook only when a county has a genuine
  // distinctive angle — don't fabricate.
  const _metaHook = (countyContent && countyContent.metaHook) ? countyContent.metaHook : null;
  const _descBody = _metaHook ? _metaHook : ('bats, squirrels, raccoons, armadillos. Local ' + countyName + ' contractor.');
  const _defaultDesc = 'Got wildlife in your ' + cityName + ' home? Same-day licensed removal — ' + _descBody + ' Call 24/7.';
  const pageDesc = (cityContent && cityContent.metaDescription) ? cityContent.metaDescription : _defaultDesc;
  const ogImage = (cityContent && cityContent.ogImage)
    ? cityContent.ogImage
    : 'https://www.removewildlifenow.com/images/hero1.jpg';
  // Optional per-page override for og:title / twitter:title (separate from
  // pageTitle which drives the <title> tag). Falls back to pageTitle when unset.
  const socialTitle = (cityContent && cityContent.ogTitle) || pageTitle;
  const seoEnhanced = !!(cityContent && cityContent.geo);
  const stateRegion = stateName === 'Georgia' ? 'GA'
    : stateName === 'Tennessee' ? 'TN'
    : stateName === 'Delaware' ? 'DE'
    : stateName === 'Connecticut' ? 'CT'
    : stateName === 'New Hampshire' ? 'NH'
    : stateName === 'Vermont' ? 'VT'
    : stateName === 'Rhode Island' ? 'RI' : '';
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('_ga') %>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= pageTitle %></title>
  <meta name="description" content="<%= pageDesc %>">
  <link rel="canonical" href="<%= pageUrl %>">
  <link rel="stylesheet" href="/css/style.css">
  <% if (!indexable) { %>
  <meta name="robots" content="noindex, follow">
  <% } else if (seoEnhanced) { %>
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
  <% } %>

  <!-- Open Graph -->
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="RemoveWildlifeNow.com">
  <meta property="og:locale" content="en_US">
  <meta property="og:url" content="<%= pageUrl %>">
  <meta property="og:title" content="<%- socialTitle %>">
  <meta property="og:description" content="<%= pageDesc %>">
  <meta property="og:image" content="<%= ogImage %>">

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content="<%- socialTitle %>">
  <meta name="twitter:description" content="<%= pageDesc %>">
  <meta name="twitter:image" content="<%= ogImage %>">

  <% if (seoEnhanced) { %>
  <!-- Geo -->
  <meta name="geo.region" content="US-<%= stateRegion %>">
  <meta name="geo.placename" content="<%= cityName %>, <%= stateName %>">
  <meta name="geo.position" content="<%= cityContent.geo.lat %>;<%= cityContent.geo.lon %>">
  <meta name="ICBM" content="<%= cityContent.geo.lat %>, <%= cityContent.geo.lon %>">

  <!-- BreadcrumbList -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "@id": pageUrl + "#breadcrumb",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "https://www.removewildlifenow.com/" },
      { "@type": "ListItem", "position": 2, "name": stateName, "item": "https://www.removewildlifenow.com/" + stateSlug + "/" },
      { "@type": "ListItem", "position": 3, "name": countyName, "item": "https://www.removewildlifenow.com/" + stateSlug + "/" + countySlug + "/" },
      { "@type": "ListItem", "position": 4, "name": cityName }
    ]
  }) %>
  </script>

  <!-- WebPage -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "WebPage",
    "@id": pageUrl + "#webpage",
    "url": pageUrl,
    "name": pageTitle,
    "description": pageDesc,
    "isPartOf": { "@id": "https://www.removewildlifenow.com/#website" },
    "breadcrumb": { "@id": pageUrl + "#breadcrumb" },
    "inLanguage": "en-US",
    "about": { "@id": pageUrl + "#business" },
    "primaryImageOfPage": ogImage
  }) %>
  </script>

  <!-- Place -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Place",
    "@id": pageUrl + "#place",
    "name": cityName + ", " + stateName,
    "address": {
      "@type": "PostalAddress",
      "addressLocality": cityName,
      "addressRegion": stateRegion,
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": cityContent.geo.lat,
      "longitude": cityContent.geo.lon
    },
    ...(cityContent.sameAs && cityContent.sameAs.length ? { "sameAs": cityContent.sameAs } : {})
  }) %>
  </script>
  <% } %>

  <%# Page-level local-business entity. One canonical entity per page:
      PestControl when LeadPortal has an assigned contractor for the parent
      county, LocalBusiness/ProfessionalService directory fallback otherwise.
      @id stays "#business" in both branches. %>
  <% if (countyContent && countyContent.contractor) { %>
  <!-- LocalBusiness/ProfessionalService — assigned local contractor entity
       (wildlife removal industry signaled via additionalType for crawlers
       that resolve schema.org subtype URLs; LocalBusiness is the primary
       @type for universal validator + provider-reference compatibility). -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService"],
    "additionalType": "https://schema.org/PestControl",
    ...(seoEnhanced ? { "@id": pageUrl + "#business" } : {}),
    "name": countyContent.contractor.name,
    "description": pageDesc,
    "url": countyContent.contractor.url ? normalizeUrl(countyContent.contractor.url) : pageUrl,
    "telephone": countyContent.contractor.telephone,
    "image": countyContent.contractor.image || "https://www.removewildlifenow.com/images/og-default.jpg",
    "priceRange": "$$",
    "address": {
      "@type": "PostalAddress",
      ...(countyContent.contractor.streetAddress ? { "streetAddress": toTitleCase(countyContent.contractor.streetAddress) } : {}),
      "addressLocality": countyContent.contractor.addressLocality ? toTitleCase(countyContent.contractor.addressLocality) : cityName,
      "addressRegion": normalizeStateRegion(countyContent.contractor.addressRegion || stateRegion),
      ...(countyContent.contractor.postalCode ? { "postalCode": countyContent.contractor.postalCode } : {}),
      "addressCountry": "US"
    },
    "areaServed": [
      { "@type": "City", "name": cityName + ", " + stateName },
      { "@type": "AdministrativeArea", "name": countyName + ", " + stateName }
    ],
    "openingHours": "Mo-Su 00:00-23:59",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Wildlife Removal Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Raccoon Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Squirrel Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bat Removal & Exclusion" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Snake Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Opossum Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Skunk Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Armadillo Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Coyote Control" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Attic Decontamination & Remediation" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Animal Exclusion & Entry-Point Sealing" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dead Animal Removal" } }
      ]
    }
  }) %>
  </script>
  <% } else { %>
  <!-- LocalBusiness / ProfessionalService — directory fallback (no contractor assigned) -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": ["LocalBusiness", "ProfessionalService"],
    ...(seoEnhanced ? { "@id": pageUrl + "#business" } : {}),
    "name": "Wildlife Removal in " + cityName,
    "description": pageDesc,
    "url": pageUrl,
    "telephone": "+1-844-544-3498",
    "priceRange": "$$",
    ...(seoEnhanced ? {
      "address": {
        "@type": "PostalAddress",
        "addressLocality": cityName,
        "addressRegion": stateRegion,
        "addressCountry": "US"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": cityContent.geo.lat,
        "longitude": cityContent.geo.lon
      }
    } : {}),
    "areaServed": [
      { "@type": "City", "name": cityName + ", " + stateName },
      { "@type": "AdministrativeArea", "name": countyName + ", " + stateName }
    ],
    "openingHours": "Mo-Su 00:00-23:59",
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Wildlife Removal Services",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Raccoon Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Squirrel Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Bat Removal & Exclusion" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Snake Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Opossum Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Skunk Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Armadillo Removal" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Coyote Control" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Attic Decontamination & Remediation" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Animal Exclusion & Entry-Point Sealing" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Dead Animal Removal" } }
      ]
    }
  }) %>
  </script>
  <% } %>

  <% if (cityContent && cityContent.faqs && cityContent.faqs.length) { %>
  <!-- FAQPage -->
  <script type="application/ld+json">
  <%- JSON.stringify({
    "@context": "https://schema.org",
    "@type": "FAQPage",
    ...(seoEnhanced ? { "@id": pageUrl + "#faq" } : {}),
    "mainEntity": cityContent.faqs.map(function(f){
      return { "@type": "Question", "name": f.q, "acceptedAnswer": { "@type": "Answer", "text": f.a } };
    })
  }) %>
  </script>
  <% } %>
  <link rel="icon" href="https://www.removewildlifenow.com/favicon.png" sizes="180x180" type="image/png">
</head>
<body>
  <%
    // Contractor-aware locals for every in-body anchor and the business-name
    // slot. When LeadPortal has an assigned contractor for this county, use
    // that contractor's phone + name; otherwise fall back to the central
    // dispatch number for phone and null (keeps the hidden .llp-company-name
    // paragraph for the LeadPortal client-side injection safety net).
    // formatPhone() handles E.164 input and is a no-op for already-formatted values.
    const _phone = (countyContent && countyContent.contractor && countyContent.contractor.telephone)
      ? countyContent.contractor.telephone
      : '+18445443498';
    const _phoneDisplay = formatPhone(_phone);
    const _companyName = (countyContent && countyContent.contractor && countyContent.contractor.name)
      ? countyContent.contractor.name
      : null;
  %>
  <header>
    <div class="container header-inner">
      <a href="/" class="logo">RemoveWildlife<span>Now</span></a>
      <nav class="header-nav">
        <a href="/">Home</a>
        <a href="/<%= stateSlug %>/"><%= stateName %></a>
        <a href="/<%= stateSlug %>/<%= countySlug %>/"><%= countyName %></a>
      </nav>
      <a class="llp-phone header-phone" href="tel:<%= _phone %>">
        <svg width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
        <%= _phoneDisplay %>
      </a>
    </div>
  </header>

  <div class="trust-bar">
    <div class="container trust-bar-inner">
      <div class="trust-item">24/7 Emergency Response</div>
      <div class="trust-item">Licensed &amp; Insured</div>
      <div class="trust-item">Humane Methods</div>
      <div class="trust-item">Local Experts</div>
    </div>
  </div>

  <main>
    <nav class="breadcrumb">
      <div class="container">
        <a href="/">Home</a> &rsaquo; <a href="/<%= stateSlug %>/"><%= stateName %></a> &rsaquo; <a href="/<%= stateSlug %>/<%= countySlug %>/"><%= countyName %></a> &rsaquo; <span><%= cityName %></span>
      </div>
    </nav>

    <section class="page-hero">
      <div class="container">
        <div class="hero-badge">Serving <%= cityName %>, <%= stateName %></div>
        <h1><%= (cityContent && cityContent.h1Override) || ('Wildlife Removal in ' + cityName) %></h1>
        <p>Raccoons in the attic? Bats in the chimney? Snake by the door? <%= cityName %>'s licensed wildlife pros — same-day service, humane methods. Call now.</p>
      </div>
    </section>

    <section class="cta-section">
      <div class="container">
        <div class="cta-box">
          <h2>Your <%= cityName %> Wildlife Removal Expert</h2>
          <% if (_companyName) { %>
          <p class="llp-company-name company-name"><%= _companyName %></p>
          <% } else { %>
          <p class="llp-company-name company-name" style="display:none;"></p>
          <% } %>
          <p class="cta-sub">Licensed, insured &amp; local. Same-day and emergency service available in <%= cityName %>.</p>
          <div class="phone-wrap">
            <a class="llp-phone phone-cta" href="tel:<%= _phone %>">
              <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
              <%= _phoneDisplay %>
            </a>
          </div>
          <p class="cta-note llp-available-only">Serving <%= cityName %> and all of <%= countyName %>, <%= stateName %></p>
          <% if (!indexable) { %>
          <div class="no-contractor-section" id="no-contractor">
            <h3><a href="tel:<%= _phone %>" style="color:inherit;text-decoration:none;"><%= _phoneDisplay %></a></h3>
            <p>We're expanding fast. Contact us and we'll connect you with help in <%= cityName %>.</p>
            <a href="/contact/?county=<%= encodeURIComponent(countyName) %>&state=<%= encodeURIComponent(stateName) %>" class="btn-contact">Contact Us for Help</a>
          </div>
          <% } %>
          <div class="cta-badges">
            <span class="cta-badge"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg> Licensed &amp; Insured</span>
            <span class="cta-badge"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Same-Day Available</span>
            <span class="cta-badge"><svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg> Humane Methods</span>
          </div>
        </div>
      </div>
    </section>

    <section class="services-section">
      <div class="container">
        <h2>Wildlife Removal Services in <%= cityName %></h2>
        <p class="section-sub">Our <%= countyName %> contractor serves all of <%= cityName %> — the same licensed professional handles every job in your area.</p>
        <ul class="counties-grid">
          <% ANIMALS.forEach(a => { %>
          <li><a href="/<%= stateSlug %>/<%= countySlug %>/<%= citySlug %>/<%= a.slug %>/" title="<%= a.plural %> in <%= cityName %>, <%= stateName %>"><%= a.emoji %> <%= a.name %> in <%= cityName %></a></li>
          <% }); %>
        </ul>
      </div>
    </section>

    <%# Mid-page CTA — repeats the call prompt between the services list and
        the long-form wildlife content. Reuses contractor _phone/_phoneDisplay
        from the top-of-body helper block. %>
    <section class="cta-section">
      <div class="container" style="text-align:center;">
        <p style="font-size:1.15rem;font-weight:600;margin:0 0 14px;color:#1f4e30;">Wildlife problem in <%= cityName %>? Call for same-day service.</p>
        <a class="llp-phone phone-cta" href="tel:<%= _phone %>">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          <%= _phoneDisplay %>
        </a>
      </div>
    </section>

    <section class="county-content">
      <div class="container">
        <h2>Wildlife Problems in <%= cityName %>, <%= stateName %></h2>
        <% if (cityContent && cityContent.wildlife_intro) { %>
        <% if (cityContent.wildlife_intro.trim().charAt(0) === '<') { %>
        <%- cityContent.wildlife_intro %>
        <% } else { %>
        <p><%- cityContent.wildlife_intro %></p>
        <% } %>
        <% if (stateInfo) { %>
        <p>The contractor serving <%= cityName %> is licensed by the <strong><%= stateInfo.agency %></strong> and knows the specific wildlife patterns, local regulations, and most effective removal methods for your area.</p>
        <% } %>
        <% } else if (stateInfo) { %>
        <p><%= stateInfo.wildlifeNote %></p>
        <p>The contractor serving <%= cityName %> is licensed by the <strong><%= stateInfo.agency %></strong> and knows the specific wildlife patterns, local regulations, and most effective removal methods for your area. <%= stateInfo.seasonNote %></p>
        <% } else { %>
        <p>Homeowners in <%= cityName %> deal with many of the same wildlife issues found throughout <%= countyName %>. Raccoons, squirrels, bats, and snakes are among the most common — often entering through damaged soffits, vents, and rooflines in residential neighborhoods.</p>
        <p>The contractor serving <%= cityName %> is based in <%= countyName %> and knows the specific wildlife patterns, local regulations, and most effective removal methods for your area.</p>
        <% } %>

        <% if (cityContent && cityContent.neighborhoods && cityContent.neighborhoods.length) { %>
        <h3><%= cityName %> Neighborhoods We Serve</h3>
        <p>The local contractor handles wildlife removal calls across every neighborhood and corridor in <%= cityName %>, including:</p>
        <ul class="tips-list">
          <% cityContent.neighborhoods.forEach(function(n) { %>
          <li><%= n %></li>
          <% }); %>
        </ul>
        <% } %>

        <% if (cityContent && cityContent.geographic_features && cityContent.geographic_features.length) { %>
        <h3>Local Geography Driving Wildlife Pressure</h3>
        <p><%= cityName %>'s wildlife corridors and natural features include:</p>
        <ul class="tips-list">
          <% cityContent.geographic_features.forEach(function(g) { %>
          <li><%= g %></li>
          <% }); %>
        </ul>
        <% } %>

        <h3>Why Use a Local <%= cityName %> Contractor?</h3>
        <ul class="tips-list">
          <% if (cityContent && cityContent.whyLocal && cityContent.whyLocal.length) { %>
            <% cityContent.whyLocal.forEach(function(item) { %>
            <li><%- item %></li>
            <% }); %>
          <% } else { %>
          <li>They know the wildlife species most common to <%= cityName %> neighborhoods</li>
          <li>Familiar with local ordinances and <%= stateName %> wildlife removal regulations</li>
          <li>Faster response time — they're already in your area</li>
          <li>Follow-up visits are easy when the contractor is local</li>
          <% } %>
        </ul>
      </div>
    </section>

    <% if (cityContent && cityContent.extendedBody) { %>
    <section class="county-content">
      <div class="container">
        <%- cityContent.extendedBody %>
      </div>
    </section>
    <% } %>

    <% if (cityContent && cityContent.faqs && cityContent.faqs.length) { %>
    <section class="faq-section">
      <div class="container">
        <h2><%= cityName %> Wildlife Removal FAQ</h2>
        <% cityContent.faqs.forEach(function(faq) { %>
        <details class="faq-item">
          <summary><%= faq.q %></summary>
          <p><%- faq.a %></p>
        </details>
        <% }); %>
      </div>
    </section>
    <% } %>

    <%# Other cities in the same county — descriptive-anchor cross-links for
        sibling city pages. Only renders when the parent county has more than
        one indexable city; degrades cleanly when it doesn't. %>
    <% if (typeof cities !== 'undefined' && cities && cities.length > 1) {
         const _otherCities = cities.filter(function(c) { return c !== cityName; });
    %>
    <section class="services-section">
      <div class="container">
        <h2>Other Cities in <%= countyName %></h2>
        <ul class="counties-grid">
          <% _otherCities.forEach(function(c) { %>
          <li><a href="/<%= stateSlug %>/<%= countySlug %>/<%= toSlug(c) %>/" title="<%= c %> Wildlife Removal"><%= c %> Wildlife Removal</a></li>
          <% }); %>
        </ul>
      </div>
    </section>
    <% } %>

    <%# Final-page CTA — last call prompt before the user reaches the footer. %>
    <section class="cta-section">
      <div class="container" style="text-align:center;">
        <p style="font-size:1.15rem;font-weight:600;margin:0 0 14px;color:#1f4e30;">Wildlife problem in <%= cityName %>? Call for same-day service.</p>
        <a class="llp-phone phone-cta" href="tel:<%= _phone %>">
          <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9.81a19.79 19.79 0 01-3.07-8.63A2 2 0 012 1h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L6.09 8.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
          <%= _phoneDisplay %>
        </a>
      </div>
    </section>
  </main>

  <footer>
    <div class="container">
      <p style="margin:0 0 6px;">Wildlife removal company? <a href="/list-your-business/" style="color:inherit;text-decoration:underline;">List your business</a> for exclusive county leads.</p>
      <p>&copy; <%= new Date().getFullYear() %> RemoveWildlifeNow.com &mdash; Connecting homeowners with licensed wildlife removal professionals nationwide.</p>
    </div>
  </footer>

  <script src="<%- embedScript %>"></script>

  <%# Sticky mobile call CTA — reuses the top-of-body _phone / _phoneDisplay
      that already gate every in-page anchor on the same contractor. %>
