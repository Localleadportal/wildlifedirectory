<%
  const P = present;
  const abbr = stateName === 'Georgia' ? 'GA' : stateName === 'Tennessee' ? 'TN' : '';
  const pageUrl = 'https://www.removewildlifenow.com/' + stateSlug + '/' + citySlug + '/';
  const canonical = (typeof canonicalUrl !== 'undefined' && canonicalUrl)
    ? canonicalUrl.replace('https://www.removewildlifenow.com', '') : '/' + stateSlug + '/' + citySlug + '/';
  // County copy may carry {{company}} / {{phone}} tokens — filled ONLY from
  // this page's single pro object, so the number rule holds everywhere.
  const fillTokens = (s) => {
    if (!s) return s;
    let out = P.scrubVoice(String(s)
      .replace(/\{\{\s*company\s*\}\}/g, pro.assigned ? pro.name : 'RemoveWildlifeNow')
      .replace(/\{\{\s*phone\s*\}\}/g, pro.phoneDisplay));
    // Authored copy sometimes carries the (844) fallback number in prose. On
    // an assigned county's pages every number must be the contractor's.
    if (pro.assigned) {
      const dashed = pro.phoneE164.replace('+1', '').replace(/(\d{3})(\d{3})(\d{4})/, '$1-$2-$3');
      out = out.split('(844) 544-3498').join(pro.phoneDisplay)
               .split('+18445443498').join(pro.phoneE164)
               .split('844-544-3498').join(dashed);
    }
    return out;
  };
  const cc = countyContent || {};
  const title = (cityContent && cityContent.metaTitle) ? fillTokens(cityContent.metaTitle)
    : (cc.metaTitle ? fillTokens(cc.metaTitle) : cityName + ', ' + abbr + ' Wildlife Removal — Out, Sealed & Cleaned Up');
  const metaDesc = (cityContent && cityContent.metaDescription) ? fillTokens(cityContent.metaDescription)
    : (cc.metaDescription ? fillTokens(cc.metaDescription)
    : 'Wildlife removal in ' + cityName + ', ' + abbr + ' — raccoons, squirrels, bats, rats, snakes and armadillos out, entry points sealed, attic cleaned up. Call ' + pro.phoneDisplay + '.');
  const heroLede = fillTokens(cc.heroIntro) || fillTokens(cc.metaHook) ||
    ('Heard something in the attic? Found droppings, a smell, or damage you can\'t explain? We remove wildlife from ' + cityName + ' homes, seal how it got in, and clean up what it left behind.');
  const faqs = (composed && composed.countyFaqs) || [];
  const texture = composed && composed.texture;
  const leadForm = include('_lead-form', { animalSlug: '' });
  const schemaObj = { "@context": "https://schema.org", "@graph": [
    P.serviceSchema({ pro, pageUrl, serviceType: 'Wildlife Removal', areaName: cityName + ', ' + stateName }),
    ...(P.faqSchema(faqs) ? [P.faqSchema(faqs)] : [])
  ]};
  const schema = JSON.stringify(schemaObj);
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label: stateName, href:'/' + stateSlug + '/'}, {label: cityName}])}
    <p class="kicker">${P.esc(countyName)} · ${P.esc(stateName)}</p>
    <h1>${P.esc(cityName)} wildlife removal — out, sealed, cleaned up</h1>
    <p class="lede">${heroLede}</p>
    <div class="btnrow">
      <a class="btn" href="tel:${pro.phoneE164}">Call ${pro.phoneDisplay}</a>
      <a class="btn alt" href="/guides/wildlife-removal-cost-in-georgia/">What it costs</a>
    </div>
    <div class="picker">
      <p class="pk-label">Start with what you&rsquo;re noticing in ${P.esc(cityName)}</p>
      <div class="chips">
        ${PROBLEMS.map(p => `<a class="chip" href="/problems/${p.slug}/">${P.esc(p.title)}</a>`).join('')}
      </div>
    </div>
    <figure class="hero-photo"><img src="/images/city-${stateSlug}-${citySlug}.webp" alt="Wildlife removal work in ${P.esc(cityName)}, ${P.esc(stateName)}" loading="lazy" onerror="this.parentNode.style.display='none'"></figure>
  </div>
</section>

<section class="section">
  <div class="container">
    <p class="kicker">The animals</p>
    <h2>What we take out of ${P.esc(cityName)} homes</h2>
    <div class="rows">
      ${cityAnimals.map((a, i) => `
      <a class="rowline" href="/${stateSlug}/${citySlug}/${a.slug}/">
        <span class="rl-num">${String(i + 1).padStart(2, '0')}</span>
        <span class="rl-main"><strong>${P.esc(a.name)} in ${P.esc(cityName)}</strong><span>${P.esc((ANIMALS.find(x => x.slug === a.slug) || {}).shortDesc || '')}</span></span>
        <span class="rl-go">Details →</span>
      </a>`).join('')}
    </div>

    ${composed && composed.introFrame ? `<p style="max-width:48em">${P.esc(composed.introFrame)}</p>` : ''}
    ${composed && composed.cityIntro ? composed.cityIntro.split(/\n\s*\n/).map(p => `<p style="max-width:48em">${fillTokens(p)}</p>`).join('') : ''}
    ${(composed && composed.cityNotes && (composed.cityNotes.neighborhoods.length || composed.cityNotes.housing || composed.cityNotes.geo)) ? `<div class="fieldnotes"><p class="kicker">Around ${P.esc(cityName)}</p>${composed.cityNotes.neighborhoods.length ? `<p><strong>Neighbourhoods we work:</strong> ${composed.cityNotes.neighborhoods.map(n => P.esc(n)).join(' · ')}</p>` : ''}${composed.cityNotes.housing ? `<p>${fillTokens(P.esc(composed.cityNotes.housing))}</p>` : ''}${composed.cityNotes.geo ? `<p>${fillTokens(P.esc(composed.cityNotes.geo))}</p>` : ''}</div>` : ''}
    ${composed && composed.geoNote ? `<p style="max-width:48em">${P.esc(composed.geoNote)}</p>` : ''}
    ${cc.blockA ? `<h2>Wildlife in ${P.esc(countyName)}</h2><p style="max-width:48em">${fillTokens(cc.blockA)}</p>` : ''}
    ${texture ? `<div class="fieldnotes"><p class="kicker">Field notes — ${P.esc(countyName)}</p><p>${P.esc(texture.terrain)}</p><p>${P.esc(texture.housing)}</p><p>${P.esc(texture.pressure)}</p></div>` : ''}
    ${composed && composed.cityBody ? fillTokens(composed.cityBody) : ''}
    ${composed && composed.extendedHtml ? fillTokens(composed.extendedHtml) : ''}
    ${composed && composed.localBridge ? `<p style="max-width:48em">${P.esc(composed.localBridge)}</p>` : ''}

    <p class="kicker" style="margin-top:2em">How the job runs</p>
    <h2>From first call to sealed attic</h2>
    <div class="steps">
      <div class="step"><span class="st-num">01</span><h3>Call &amp; describe it</h3><p>Tell us the sound, smell or sighting. We&rsquo;ll name the likely animal and what the job usually takes.</p></div>
      <div class="step"><span class="st-num">02</span><h3>Inspect</h3><p>Attic, roofline, vents and crawlspace — animals, damage and every entry point, priced up front.</p></div>
      <div class="step"><span class="st-num">03</span><h3>Out &amp; sealed</h3><p>Humane removal matched to the animal, then entry points sealed in chew-proof materials.</p></div>
      <div class="step"><span class="st-num">04</span><h3>Cleaned up</h3><p>Droppings and fouled insulation out, attic sanitised, and a walk-through of what to watch for.</p></div>
    </div>

    ${leadForm}
    ${P.callCard(pro, { heading: cityName + ' — one call and it&rsquo;s handled' })}
    ${P.faqSection(faqs, cityName + ' wildlife questions')}

    ${otherCities && otherCities.length ? `<h2>Nearby towns in ${P.esc(countyName)}</h2><div class="citylinks">${otherCities.map(c => `<a href="/${stateSlug}/${c.slug}/">${P.esc(c.name)}</a>`).join('')}</div>` : ''}
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, schema, body }) %>
