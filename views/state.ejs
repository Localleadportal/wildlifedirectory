<%
  const slug = toSlug(stateName);
  const abbr = stateName === 'Georgia' ? 'GA' : stateName === 'Tennessee' ? 'TN' : '';
  const title = stateName + ' Wildlife Removal — County by County | RemoveWildlifeNow';
  const metaDesc = 'Wildlife removal across ' + stateName + ': raccoons, squirrels, bats, rats, snakes, armadillos and more — out, sealed and cleaned up. Same-day service, open 24/7. Call ' + pro.phoneDisplay + '.';
  const canonical = '/' + slug + '/';
  const P = present;
  const overview = (stateInfo && Array.isArray(stateInfo.overview)) ? stateInfo.overview.map(s => P.scrubVoice(s)) : [];
  const faqs = (stateInfo && Array.isArray(stateInfo.faqs)) ? stateInfo.faqs.slice(0, 5).map(f => ({ q: P.scrubVoice(f.q), a: P.scrubVoice(f.a) })) : [];
  const schemaObj = { "@context": "https://schema.org", "@graph": [
    P.serviceSchema({ pro, pageUrl: 'https://www.removewildlifenow.com' + canonical, serviceType: 'Wildlife Removal', areaName: stateName }),
    ...(P.faqSchema(faqs) ? [P.faqSchema(faqs)] : [])
  ]};
  const schema = JSON.stringify(schemaObj);
  const body = `
<section class="hero">
  <div class="container">
    ${P.crumbsHtml([{label:'Home', href:'/'}, {label: stateName}])}
    <p class="kicker">${P.esc(stateName)} · ${cities.length} towns covered</p>
    <h1>${P.esc(stateName)} wildlife removal, county by county</h1>
    <p class="lede">${overview.length ? P.esc(overview[0]) : ''}</p>
    <div class="btnrow">
      <a class="btn" href="tel:${pro.phoneE164}">Call ${pro.phoneDisplay}</a>
      <a class="btn alt" href="/problems/">Start with the problem</a>
    </div>
  </div>
</section>

<section class="section">
  <div class="container">
    ${overview.slice(1).map(p => `<p style="max-width:48em">${P.esc(p)}</p>`).join('')}
    ${stateInfo && stateInfo.wildlifeNote ? `<div class="fieldnotes"><p class="kicker">Field notes — ${P.esc(stateName)}</p><p>${P.esc(P.scrubVoice(stateInfo.wildlifeNote))}</p>${stateInfo.seasonNote ? `<p>${P.esc(P.scrubVoice(stateInfo.seasonNote))}</p>` : ''}${stateInfo.batNote ? `<p>${P.esc(P.scrubVoice(stateInfo.batNote))}</p>` : ''}</div>` : ''}

    <p class="kicker">By animal</p>
    <h2>${P.esc(stateName)} animals we remove</h2>
    <div class="rows">
      ${stateAnimalLinks.map((l, i) => `
      <a class="rowline" href="/${slug}/${l.slug}/">
        <span class="rl-num">${String(i + 1).padStart(2, '0')}</span>
        <span class="rl-main"><strong>${P.esc(l.name)} in ${P.esc(stateName)}</strong><span>Signs, seasons, the law, and how the job runs here.</span></span>
        <span class="rl-go">${abbr} guide →</span>
      </a>`).join('')}
    </div>

    <p class="kicker" style="margin-top:2em">By town</p>
    <h2>Towns we cover in ${P.esc(stateName)}</h2>
    <div class="citylinks">
      ${cities.map(c => `<a href="/${slug}/${c.slug}/">${P.esc(c.name)} <span style="color:var(--muted)">— ${P.esc(c.countyName)}</span></a>`).join('')}
    </div>

    ${stateInfo && stateInfo.agency ? `<p class="fineprint" style="margin-top:22px">Wildlife rules here are set by the ${P.esc(stateInfo.agency)}. Our work follows them — licensed nuisance wildlife control, humane methods, and no relocation where the law forbids it.</p>` : ''}
    ${P.callCard(pro, { heading: stateName + ' wildlife, handled' })}
    ${P.faqSection(faqs, stateName + ' questions')}
  </div>
</section>`;
%><%- include('layout', { title, metaDesc, canonical, schema, body }) %>
